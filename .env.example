# Публичный домен шлюза WebCodex
MCP_DOMAIN=codex.grom.world

# Порт на локальном хосте для проксирования через Nginx
WEBCODEX_PORT=38971

# Учетные данные администратора для входа в веб-панель /admin
WEBCODEX_ADMIN_USER=admin
WEBCODEX_ADMIN_PASSWORD=CHANGE_ME_TO_A_VERY_LONG_RANDOM_PASSWORD

# Необязательные настройки
WEBCODEX_CALL_TIMEOUT=60s
WEBCODEX_ACCESS_TOKEN_TTL=24h

# Локальный agent (задайте в его окружении, не в контейнере Gate)
# WEBCODEX_ALLOWED_ROOTS=C:\projects;D:\work
# WEBCODEX_LOG_DIR=C:\webcodex\logs
# WEBCODEX_PROCESS_TTL=24h
# WEBCODEX_MAX_LOG_BYTES=52428800
# WEBCODEX_MAX_RESPONSE_BYTES=262144
# WEBCODEX_VERBOSE=1
# Видимый браузер запускается в интерактивной пользовательской сессии
# WEBCODEX_BROWSER_ENABLED=0
# WEBCODEX_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WEBCODEX_BROWSER_DIR=C:\Users\user\AppData\Roaming\webcodex\browser
# WEBCODEX_BROWSER_ALLOW_LOCAL=0
# WEBCODEX_BROWSER_PERSONAL_ENABLED=0
# WEBCODEX_BROWSER_DOWNLOAD_DIR=C:\Users\user\Downloads
