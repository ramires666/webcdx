{
  "manifest_version": 3,
  "name": "WebCodex AI Studio Bridge",
  "version": "0.3.8",
  "description": "Соединяет Google AI Studio с локальным агентом WebCodex; Gate используется как резерв.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "identity", "alarms", "scripting"],
  "host_permissions": ["https://aistudio.google.com/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Открыть WebCodex Bridge" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [{
    "matches": ["https://aistudio.google.com/*"],
    "js": ["protocol.js", "studio-adapter.js", "content.js"],
    "run_at": "document_idle"
  }]
}
