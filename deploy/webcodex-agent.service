[Unit]
Description=WebCodex local MCP agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webcodex
Group=webcodex
Environment=HOME=/home/webcodex
EnvironmentFile=/etc/webcodex/agent.env
ExecStart=/usr/local/bin/webcodex-agent
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/srv/projects -/opt/work -/var/log/webcodex-agent

[Install]
WantedBy=multi-user.target
