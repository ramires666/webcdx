{
  "manifest_version": 3,
  "name": "WebCodex Local Browser",
  "description": "Use your signed-in browser through WebCodex with optional persistent access and automatic reconnection.",
  "version": "1.2.0",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["tabs", "debugger", "nativeMessaging", "downloads", "storage", "alarms"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "WebCodex: attach, pause or disconnect"}
}
