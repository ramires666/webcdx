FROM golang:1.25-bookworm AS builder

ARG VERSION=1.5.0-ai-studio-alpha.1

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/gate ./cmd/gate
COPY internal ./internal

RUN CGO_ENABLED=0 \
    GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w -X webcodex/internal/buildinfo.Version=${VERSION}" \
    -o /out/webcodex-gate \
    ./cmd/gate

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S webcodex \
    && adduser -S -G webcodex webcodex \
    && mkdir -p /data \
    && chown -R webcodex:webcodex /data

WORKDIR /app

COPY --from=builder /out/webcodex-gate /app/webcodex-gate

USER webcodex

EXPOSE 8080

VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/app/webcodex-gate"]
